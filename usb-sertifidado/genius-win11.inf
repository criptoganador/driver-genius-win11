[Version]
Signature   = "$WINDOWS NT$"
Class       = Camera
ClassGuid   = {ca3e7ab9-b4c3-4ae6-8251-579ef933890f}
Provider    = %ManufacturerName%
CatalogFile = genius-win11.cat
DriverVer   = 07/17/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ManufacturerName% = DeviceList, NTamd64

; Solo MI_00 (Video/Control) se gestiona aquí con WinUSB.
; MI_01 (Audio) es gestionado automáticamente por Windows con usbaudio.sys.
[DeviceList.NTamd64]
%DeviceName_Video% = Video_Device, USB\VID_0C45&PID_60B0&MI_00

[Video_Device]
Include = winusb.inf
Needs   = WINUSB.NT

[Video_Device.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services
AddService = WinUSB, 0x00000002, WinUSB_Install_Service

[WinUSB_Install_Service]
DisplayName    = "Genius VideoCam WinUSB Driver"
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\WinUSB.sys

[Video_Device.HW]
AddReg = Dev_AddReg, Power_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{15B22409-5FEF-4481-9EFD-6F4E85882512}"
HKR,,Security,,"D:P(A;;GA;;;BA)(A;;GA;;;SY)(A;;GRGWGX;;;BU)"

[Power_AddReg]
HKR,,DeviceSelectiveSuspended,0x00010001,1
HKR,,SelectiveSuspendEnabled,0x00010001,1

[Strings]
ManufacturerName  = "Jhoan Gavidia"
DeviceName_Video  = "Genius VideoCam Look - Video Stream"
